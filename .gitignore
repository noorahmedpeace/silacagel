# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# service account credentials
gsc-key.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Playwright
test-results/
playwright-report/

# Private commercial data - real buyers' names, emails and phone numbers.
# This repository is public; these must never be committed.
/outreach-buyer-list*.csv
/outreach-emails-*.md
/outreach-messages.md
/outreach-top20-international.md
/rfq-*-reply.md
/docs/growth/OUTREACH-TRACKER.csv

# Outreach run artifacts - contain buyer addresses.
/outreach-sent.log
/outreach-preview.txt

# Outreach hitlists carry third-party contact addresses - never in a public repo.
/OUTREACH-*.md

# single-instance lock files
/*.lock
/autoreply-log.json
/inbox-triage-state.json
/inbox-triage-state.json.tmp
/inbox-triage-log.jsonl
/sc-media-50.json
/sc-scheduled-50.json
/sc-scheduled-50b.json
